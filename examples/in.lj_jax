units lj
atom_style atomic
boundary f f f
newton off

lattice sc 0.8
region box block 0 8 0 8 0 16
create_box 1 box
create_atoms 1 box
mass 1 1.0

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes one 256 page 500000

# -var pjrt /absolute/path/xla_cuda_plugin.so; bundle path is repo-root relative.
pair_style jax/kk ${pjrt}
pair_coeff * * examples/lj.lammps-jax.json

velocity all create 0.1 12345
fix int all nve
thermo 100
thermo_style custom step temp
run_style verlet/kk
run 0
run 1000
