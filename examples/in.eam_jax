# .venv/bin/python examples/export_model.py eam examples/eam.lammps-jax.json \
#   --max-atoms 4096 --edges-per-atom 64
# LAMMPS_PLUGIN_PATH=build-plugin-gpu-pjrt \
#   "$LAMMPS_INSTALL/bin/lmp" -k on g 1 -pk kokkos newton on neigh half -sf kk \
#   -var pjrt /absolute/path/xla_cuda_plugin.so -in examples/in.eam_jax

units lj
atom_style atomic
boundary p p p
newton on

lattice fcc 0.8
region box block 0 4 0 4 0 4
create_box 1 box
create_atoms 1 box
mass 1 1.0

neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes one 256 page 500000

# Bundle path is relative to the LAMMPS working directory (repo root in the
# documented run line above).
pair_style jax/kk ${pjrt}
pair_coeff * * examples/eam.lammps-jax.json

velocity all create 0.8 12345
fix int all nve
thermo 50
thermo_style custom step temp pe press
run_style verlet/kk
run 0
run 200
